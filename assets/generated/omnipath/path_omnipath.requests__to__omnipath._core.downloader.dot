  "omnipath._core.query" -> "omnipath._core.query._query" [color="#64748b", penwidth="1.0", style="solid", label="QueryType"];
  "omnipath._core.query._query" -> "omnipath._core.query._query_validator" [color="#64748b", penwidth="1.0", style="solid", label="AnnotationsValidator\\nComplexesValidator, …"];
  "omnipath._core.query._query" -> "omnipath.constants._constants" [color="#64748b", penwidth="1.0", style="solid", label="ErrorFormatter\\nFormatterMeta"];
