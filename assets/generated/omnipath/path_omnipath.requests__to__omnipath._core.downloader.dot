  "omnipath._core.utils._static" -> "omnipath._core.requests" [color="#64748b", penwidth="1.2", style="solid,dotted", label="AllInteractions\\nInteractionDataset"];
  "omnipath._core.utils._static" -> "omnipath._core.requests._annotations" [color="#64748b", penwidth="1.2", style="solid,dotted", label="Annotations"];
  "omnipath._core.utils._static" -> "omnipath._core.utils" [color="#64748b", penwidth="1.0", style="solid", label="_options"];
  "omnipath.constants" -> "omnipath.constants._constants" [color="#64748b", penwidth="1.0", style="solid", label="InteractionDataset\\nLicense, …"];
  "omnipath.constants._pkg_constants" -> "omnipath.constants" [color="#64748b", penwidth="1.0", style="solid", label="License, Organism"];
  "omnipath.constants._pkg_constants" -> "omnipath.constants._constants" [color="#64748b", penwidth="1.0", style="solid", label="PrettyEnumMixin"];
