  "omnipath._core.requests._annotations" -> "omnipath" [color="#64748b", penwidth="1.0", style="solid", label="dtypes"];
  "omnipath._core.requests._annotations" -> "omnipath._core.query" [color="#64748b", penwidth="1.0", style="solid", label="QueryType"];
  "omnipath._core.requests._annotations" -> "omnipath._core.requests._request" [color="#64748b", penwidth="1.0", style="solid", label="OmnipathRequestABC"];
  "omnipath._core.requests._annotations" -> "omnipath._core.utils" [color="#64748b", penwidth="1.0", style="solid", label="d"];
  "omnipath._core.requests._annotations" -> "omnipath.constants._pkg_constants" [color="#64748b", penwidth="1.0", style="solid", label="Key, final"];
  "omnipath._core.requests._complexes" -> "omnipath._core.query" [color="#64748b", penwidth="1.0", style="solid", label="QueryType"];
  "omnipath._core.requests._complexes" -> "omnipath._core.requests._request" [color="#64748b", penwidth="1.0", style="solid", label="OrganismGenesymbolsRemover"];
  "omnipath._core.requests._complexes" -> "omnipath.constants._pkg_constants" [color="#64748b", penwidth="1.0", style="solid", label="final"];
  "omnipath._core.requests._intercell" -> "omnipath._core.query" [color="#64748b", penwidth="1.0", style="solid", label="QueryType, Strseq_t"];
  "omnipath._core.requests._intercell" -> "omnipath._core.query._query_validator" [color="#64748b", penwidth="1.0", style="solid", label="_to_string_set"];
  "omnipath._core.requests._intercell" -> "omnipath._core.requests._request" [color="#64748b", penwidth="1.0", style="solid", label="OrganismGenesymbolsRemover"];
  "omnipath._core.requests._intercell" -> "omnipath.constants._pkg_constants" [color="#64748b", penwidth="1.0", style="solid", label="Format, Key, final"];
  "omnipath._core.requests._request" -> "omnipath" [color="#64748b", penwidth="1.0", style="solid", label="options"];
  "omnipath._core.requests._request" -> "omnipath._core.downloader._downloader" [color="#ea580c", fontcolor="#9a3412", penwidth="2.4", style="solid,bold", label="Downloader"];
  "omnipath._core.requests._request" -> "omnipath._core.query" [color="#64748b", penwidth="1.0", style="solid", label="QueryType"];
  "omnipath._core.requests._request" -> "omnipath._core.requests._utils" [color="#64748b", penwidth="1.0", style="solid", label="_ERROR_EMPTY_FMT\\n_count_references, …"];
  "omnipath._core.requests._request" -> "omnipath._core.utils" [color="#64748b", penwidth="1.0", style="solid", label="d"];
  "omnipath._core.requests._request" -> "omnipath.constants" [color="#64748b", penwidth="1.0", style="solid", label="License, Organism"];
  "omnipath._core.requests._request" -> "omnipath.constants._pkg_constants" [color="#64748b", penwidth="1.0", style="solid", label="DEFAULT_FIELD, Format\\nKey, …"];
  "omnipath._core.requests._request" -> "omnipath.interactions" [color="#64748b", penwidth="1.2", style="solid,dotted", label="OmniPath"];
  "omnipath._core.requests._request" -> "omnipath.requests" [color="#64748b", penwidth="1.2", style="solid,dotted", label="Enzsub"];
  "omnipath._core.requests._utils" -> "omnipath" [color="#64748b", penwidth="1.2", style="solid,dotted", label="1 import"];
  "omnipath._core.requests._utils" -> "omnipath._core.utils" [color="#64748b", penwidth="1.0", style="solid", label="d"];
