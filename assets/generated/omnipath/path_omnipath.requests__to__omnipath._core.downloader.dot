  "omnipath._core.query._query_validator" -> "omnipath._core.downloader._downloader" [color="#64748b", penwidth="1.0", style="solid", label="Downloader"];
  "omnipath._core.query._query_validator" -> "omnipath._core.query" [color="#64748b", penwidth="1.0", style="solid", label="Bool_t, Int_t, License_t\\nNone_t, …"];
  "omnipath._core.query._query_validator" -> "omnipath._core.utils" [color="#64748b", penwidth="1.0", style="solid", label="Options, d"];
  "omnipath._core.query._query_validator" -> "omnipath.constants._constants" [color="#64748b", penwidth="1.0", style="solid", label="NoValue"];
  "omnipath._core.query._query_validator" -> "omnipath.constants._pkg_constants" [color="#64748b", penwidth="1.0", style="solid", label="Format, Key"];
  "omnipath._core.requests" -> "omnipath._core.requests._annotations" [color="#64748b", penwidth="1.0", style="solid", label="Annotations"];
  "omnipath._core.requests" -> "omnipath._core.requests._complexes" [color="#64748b", penwidth="1.0", style="solid", label="Complexes"];
  "omnipath._core.requests" -> "omnipath._core.requests._intercell" [color="#64748b", penwidth="1.0", style="solid", label="Intercell"];
